# ---------------------------------------------------------------------------
# Backend configuration (docs/ARCHITECTURE.md section 3).
#   Local dev:  cp .env.example backend/.env   (the API/worker read .env from their cwd)
#   Compose:    cp .env.example deploy/.env    (docker compose reads deploy/.env)
# ---------------------------------------------------------------------------

# development | production | test.  production refuses to start with a weak/default SECRET_KEY.
ENV=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite by default; Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data
# Defaults to <repo>/samples
# SAMPLES_DIR=../samples

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

MAX_UPLOAD_MB=50
MAX_FILES_PER_PROJECT=200
# Per-IP attempts per window on /api/auth/login and /api/auth/register
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Worker
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=7200
CANCEL_GRACE_SECONDS=10
# Interpreter that has the pipeline deps (backend/recon/requirements.txt); defaults to the current one.
# RECON_PYTHON=/home/you/venvs/recon/bin/python
# Directory containing the `recon` package (default: backend/)
# RECON_PATH=./
# Full command override, e.g. for the fake CLI used by tests:
# RECON_COMMAND=python tests/fake_recon/fake_cli.py

LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text
# Run `alembic upgrade head` on startup
AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# docker compose only (deploy/docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_USER=recon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recon
WEB_PORT=8080
# GPU worker: see deploy/docker-compose.gpu.yml
# WORKER_BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# ---------------------------------------------------------------------------
# Frontend (frontend/.env) - see frontend/.env.example
# ---------------------------------------------------------------------------
# VITE_API_URL=
# VITE_BASE=/

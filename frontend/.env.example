# Base URL of the FastAPI backend (no trailing slash). Leave empty to use the same origin
# (the dev server proxies /api to VITE_PROXY_TARGET, default http://localhost:8000).
VITE_API_URL=
# Public base path. "/" by default; GitHub Pages uses "/3dreconstruction/".
VITE_BASE=/
# 1 = run entirely in the browser against a simulated API (no backend needed).
VITE_MOCK=0
